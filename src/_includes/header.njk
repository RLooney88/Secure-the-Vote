<!-- Main Header -->
<header class="site-header">
  <div class="container">
    <div class="header-wrapper">
      <div class="site-logo">
        <a href="/">
          <img src="/images/logo.png" alt="Secure the Vote Maryland" />
        </a>
      </div>

      {% set nav = navigation | navigationForPage(page.url) %}
      <nav class="main-navigation">
        <button class="mobile-menu-toggle" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="menu">
          {% for item in nav.primary %}
          <li class="{% if item.children.length %}menu-item-has-children {% endif %}{% if item.isActiveTrail %}current-menu-item{% endif %}">
            <a href="{{ item.path }}">{{ item.label }}{% if item.children.length %} <i class="fas fa-chevron-down"></i>{% endif %}</a>
            {% if item.children.length %}
            <ul class="sub-menu">
              {% for child in item.children %}
              <li class="{% if child.isActiveTrail %}current-menu-item{% endif %}"><a href="{{ child.path }}">{{ child.label }}</a></li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="header-donate">
        <a href="https://donorbox.org/united-sovereign-americans-maryland-donation" target="_blank" class="donate-button">
          Donate Now
        </a>
      </div>
    </div>
  </div>
</header>
