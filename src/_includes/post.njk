<!DOCTYPE html>
<html lang="en">
<head>
  {% set ogType = 'article' %}
  {% set extraStyles = ['/css/posts.css'] %}
  {% include "head.njk" %}
</head>
<body class="site-shell site-shell--post">
  {% include "header.njk" %}
  
  <main class="main-content">
    <article class="post-content">
      <header class="post-header">
        <div class="post-meta">
          <span class="post-category">{{ categoryLabel }}</span>
          <time datetime="{{ date }}">{{ date | readableDate }}</time>
        </div>
        <h1>{{ title }}</h1>
      </header>
      
      <div class="post-body">
        {% if post %}
          {{ post.content | safe }}
        {% else %}
          {{ content | safe }}
        {% endif %}
      </div>
      
      <footer class="post-footer">
        <a href="/news/" class="back-link">&larr; Back to News</a>
      </footer>
    </article>
  </main>
  
  {% include "footer.njk" %}
  
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="/js/header.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>