# HighLevel API Configuration
HIGHLEVEL_API_KEY=your_highlevel_api_key_here
HIGHLEVEL_LOCATION_ID=your_location_id_here

# Admin Security
ADMIN_SECRET_KEY=generate_a_random_secret_key_here

# Vercel KV (automatically provided by Vercel)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Database Connection (Railway Postgres) - Required for admin dashboard
DATABASE_URL=postgresql://user:password@host:5432/database

# Media uploads (large admin uploads use direct browser -> GCS signed URLs)
# Defaults reuse the edit-request bucket/service account if already configured.
MEDIA_GCS_BUCKET=your-public-media-bucket
MEDIA_GCS_PREFIX=securethevotemd/media
MEDIA_PUBLIC_BASE_URL=https://storage.googleapis.com/your-public-media-bucket
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# JWT Secret for admin authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secure-random-secret-here

# Setup token for one-time admin creation
SETUP_TOKEN=your-setup-token-here
